# --- Public (bundled into browser JS; never put secrets here) ---
# Form provider endpoint that accepts JSON POSTs, e.g. https://formspree.io/f/xxxxxxxx
# Leave empty to keep the contact form in clearly-labelled preview mode.
VITE_FORM_ENDPOINT=

# Set to true once api/google-reviews.ts is deployed with the server variables below.
VITE_REVIEWS_API=false

# --- Build-time ---
# Final public domain, no trailing slash. Used for canonical URL, Open Graph, sitemap and robots.txt.
# On Vercel this falls back to the project's production domain automatically.
SITE_URL=https://www.example.com

# Preview mode (default: on) adds noindex and a robots.txt that blocks all crawlers.
# Set to false only once the owner has approved the site, photos and domain.
PREVIEW_MODE=true

# --- Server only (set in your host's dashboard, e.g. Vercel > Settings > Environment Variables) ---
# Google Places API (New) key, restricted to the Places API.
GOOGLE_PLACES_API_KEY=
# Place ID (starts with ChIJ...) from https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
# Seconds browsers may cache the reviews response (default 600). Check Google Maps Platform terms before increasing.
REVIEWS_CACHE_SECONDS=600
